# ==============================================================================
# NeuroScope 3D - Environment Variables (Example & Reference Only)
# ==============================================================================
# Copy this file to .env for local configuration.
# DO NOT COMMIT SECRETS OR SENSITIVE CREDENTIALS TO SOURCE CONTROL.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Inference & Model Configuration
# Expected bundle: MONAI Model Zoo brats_mri_segmentation (SegResNet)
MODEL_BUNDLE_PATH=./models/brats_mri_segmentation
MODEL_DEVICE=cuda
INFERENCE_BATCH_SIZE=1
DETERMINISTIC_MODE=true

# Storage & Lifecycle (Uploads & generated artefacts cleaned after 24h)
STORAGE_DIR=./storage/cases
TEMP_RETENTION_HOURS=24
MAX_UPLOAD_SIZE_BYTES=1073741824
